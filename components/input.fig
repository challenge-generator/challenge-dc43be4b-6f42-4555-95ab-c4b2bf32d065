{
  "name": "Input",
  "description": "Componente reutilizable Input con variantes y estados para el design system de la fintech.",
  "frames": [
    {
      "name": "Input Variants",
      "nodes": [
        {
          "type": "COMPONENT_SET",
          "name": "Input/Text",
          "description": "Campo de entrada de texto genérico.",
          "variants": [
            {
              "name": "Default",
              "properties": {
                "backgroundColor": "#FFFFFF",
                "textColor": "#000000",
                "border": "1px solid #757575",
                "borderRadius": "4px",
                "padding": "12px",
                "fontFamily": "Roboto",
                "fontSize": "14px",
                "placeholderColor": "#9E9E9E"
              }
            },
            {
              "name": "Hover",
              "properties": {
                "border": "1px solid #6200EE"
              }
            },
            {
              "name": "Focus",
              "properties": {
                "border": "2px solid #6200EE",
                "outline": "none"
              }
            },
            {
              "name": "Disabled",
              "properties": {
                "backgroundColor": "#F5F5F5",
                "textColor": "#9E9E9E",
                "border": "1px solid #E0E0E0",
                "cursor": "not-allowed"
              }
            },
            {
              "name": "Error",
              "properties": {
                "border": "1px solid #B00020",
                "errorMessage": {
                  "text": "Este campo es obligatorio",
                  "color": "#B00020",
                  "fontSize": "12px"
                }
              }
            },
            {
              "name": "Success",
              "properties": {
                "border": "1px solid #03DAC6",
                "successIcon": {
                  "color": "#03DAC6",
                  "size": "16px"
                }
              }
            }
          ]
        },
        {
