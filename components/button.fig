{
  "name": "Button",
  "description": "Componente reutilizable Button con variantes y estados para el design system de la fintech.",
  "frames": [
    {
      "name": "Button Variants",
      "nodes": [
        {
          "type": "COMPONENT_SET",
          "name": "Button/Primary",
          "description": "Botón de acción principal.",
          "variants": [
            {
              "name": "Default",
              "properties": {
                "backgroundColor": "#6200EE",
                "textColor": "#FFFFFF",
                "borderRadius": "4px",
                "padding": "12px 24px",
                "fontFamily": "Roboto",
                "fontSize": "14px",
                "fontWeight": "500"
              }
            },
            {
              "name": "Hover",
              "properties": {
                "backgroundColor": "#3700B3",
                "textColor": "#FFFFFF"
              }
            },
            {
              "name": "Focus",
              "properties": {
                "backgroundColor": "#6200EE",
                "textColor": "#FFFFFF",
                "border": "2px solid #03DAC6"
              }
            },
            {
              "name": "Disabled",
              "properties": {
                "backgroundColor": "#E0E0E0",
                "textColor": "#9E9E9E",
                "cursor": "not-allowed"
              }
            },
            {
              "name": "Error",
              "properties": {
                "backgroundColor": "#B00020",
                "textColor": "#FFFFFF"
              }
            },
            {
              "name": "Loading",
              "properties": {
                "backgroundColor": "#6200EE",
                "textColor": "#FFFFFF",
                "content": "Loading...",
                "spinner": {
                  "color": "#FFFFFF",
                  "size": "16px"
                }
              }
            }
          ]
        },
